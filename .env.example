# ============================================================================
# MAYBEWE — SUPABASE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and .env.local, then insert your real Supabase credentials.
# Do NOT commit real credentials or secret keys to version control.
# ============================================================================

# 1. EXPO FRAMEWORK (React Native / Expo Web - Primary Mobile & Web App)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt_key_here

# 2. VITE PARITY (For Vite builds / tooling)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 3. NEXT.JS PARITY (For Next.js / server components)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 4. SERVER-ONLY / MIGRATION KEYS (NEVER expose or use in browser code)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
# DATABASE_URL="postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
