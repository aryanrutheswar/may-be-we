{
  "name": "solo-traveler-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/face-detection": "^2.0.1",
    "@supabase/server": "^1.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.23",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.18",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform web && node scripts/inject-seo.js",

    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "preview": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');http.createServer((req,res)=>{let f=path.join(__dirname,'dist',req.url==='/'?'index.html':req.url.split('?')[0]);if(!fs.existsSync(f))f=path.join(__dirname,'dist','index.html');const ext=path.extname(f);const types={'.html':'text/html','.js':'application/javascript','.css':'text/css','.json':'application/json','.png':'image/png','.jpg':'image/jpeg','.ico':'image/x-icon','.ttf':'font/ttf'};res.writeHead(200,{'Content-Type':types[ext]||'application/octet-stream'});fs.createReadStream(f).pipe(res);}).listen(4173,()=>console.log('Preview: http://localhost:4173'));\"",
    "postinstall": "prisma skills sync || exit 0"
  },

  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "babel-preset-expo": "^57.0.12",
    "prisma": "^8.0.0-rc.27"
  }
}
